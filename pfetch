detect_palette() {
	# Build a row of colored blocks using reverse-video to avoid
	# hardcoding a second set of background-color sequences.
	# shellcheck disable=2154
	{
		esc SGR 7
		_pf_pal="$e$c1 $c1 $c2 $c2 $c3 $c3 $c4 $c4 $c5 $c5 $c6 $c6 "
		esc SGR 0
		_pf_pal="$_pf_pal$e"
	}

	# The palette is rendered as a name-only line (like title).
	_pf_name="$_pf_pal
        "
	_pf_val=" "
	_pf_nosep=1
}

# ============================================================================
#  [ASCII]  ASCII art selection, measurement, and printing
# ============================================================================
# ascii_init() selects the appropriate art based on PF_ASCII → distro → OS,
# measures its dimensions, prints it, and repositions the cursor.

# Helper: read ASCII art from stdin into _pf_ascii, setting default colors.
_pf_read_ascii() {
	# PF_COL1 defaults to the ASCII art's primary color.
	# PF_COL3 defaults to a different color for the title.
	PF_COL1=${PF_COL1:-${1:-7}}
	PF_COL3=${PF_COL3:-$((${1:-7}%8+1))}

	while IFS= read -r line; do
		_pf_ascii="$_pf_ascii$line
"
	done
}

