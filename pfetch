#!/bin/sh
#
# pfetch - Simple POSIX sh fetch script.
#
# INTERNAL ARCHITECTURE
# =====================
# This script is organized into clearly separated responsibility zones.
# Each section has a well-defined interface; cross-section coupling is
# limited to a documented set of shared state variables (prefixed _pf_).
#
#   [TERMINAL]  Escape-sequence primitives (esc, esc_p).
#   [UTILITY]   General helpers (has).
#   [CONFIG]    Configuration loading and color initialization.
#   [DETECT]    System information probes.  Each detect_*() sets _pf_val.
#   [ASCII]     ASCII art data, selection, and measurement.
#   [RENDER]    Info-line rendering and layout engine.
#   [MAIN]      Entry point and orchestration.
#
# SHARED STATE (the *only* intentional cross-section globals):
#   _pf_esc_c        Escape character            [CONFIG]  → [TERMINAL]
#   _pf_os           uname -s                    [DETECT]  → [DETECT], [ASCII]
#   _pf_kernel       uname -r                    [DETECT]  → [DETECT]
#   _pf_arch         uname -m                    [DETECT]  → [DETECT]
#   _pf_distro       Detected distribution name  [DETECT]  → [DETECT], [ASCII]
#   _pf_val          Current module output value [DETECT]  → [RENDER]
#   _pf_name         Display-name override       [DETECT]  → [RENDER]
#   _pf_nosep        Suppress-separator flag     [DETECT]  → [RENDER]
#   _pf_ascii_width  ASCII art width (+gap)      [ASCII]   → [RENDER]
#   _pf_ascii_height ASCII art height            [ASCII]   → [RENDER]
#   _pf_info_length  Computed alignment width    [RENDER]  → [RENDER]
#   _pf_info_height  Printed info-line count     [RENDER]  → [MAIN]
#   c1..c8           Color escape sequences      [CONFIG]  → [ASCII], [DETECT]
#

# ============================================================================
#  [TERMINAL]  Escape-sequence abstraction
# ============================================================================
# All terminal control sequences go through esc()/esc_p().  No other section
# should emit raw escape codes.

esc() {
	case $1 in
		CUU) e="${_pf_esc_c}[${2}A" ;; # cursor up
		CUD) e="${_pf_esc_c}[${2}B" ;; # cursor down
		CUF) e="${_pf_esc_c}[${2}C" ;; # cursor right
		CUB) e="${_pf_esc_c}[${2}D" ;; # cursor left

		# Text formatting (SGR).  When PF_COLOR=0 every SGR call
		# produces an empty string so the rest of the script never
		# needs to special-case color vs. no-color mode.
		SGR)
			case ${PF_COLOR:=1} in
				(1) e="${_pf_esc_c}[${2}m" ;;
				(0) e= ;;
			esac
		;;

		# Line-wrap toggle.  Not supported on all terminal types.
		DECAWM)
			case $TERM in
				(dumb | minix | cons25) e= ;;
				(*) e="${_pf_esc_c}[?7${2}" ;;
			esac
		;;
	esac
}

# Generate an escape sequence and print it immediately.
esc_p() {
	esc "$@"
	printf '%s' "$e"
}

# ============================================================================
#  [UTILITY]  General-purpose helpers
# ============================================================================

# Check whether a command exists and is executable.
# This wraps 'command -v' to guard against aliases/functions and
# to avoid spamming '>/dev/null' at every call site.
has() {
	_pf_cmd=$(command -v "$1") 2>/dev/null || return 1
	[ -x "$_pf_cmd" ] || return 1
}

# ============================================================================
#  [CONFIG]  Configuration loading and initialization
# ============================================================================
# Responsibilities:
#   - Set up the escape character used by [TERMINAL].
#   - Source the user's PF_SOURCE config (if any).
#   - Build the color map (c1..c8) used by [ASCII] and [DETECT].
#   - Validate TMPDIR.

config_init() {
	# Raw escape character — stored once, reused everywhere.
	_pf_esc_c=$(printf '\033')

	# Allow users to extend pfetch with their own script.
	# shellcheck source=/dev/null
	! [ -f "$PF_SOURCE" ] || . "$PF_SOURCE"

	# Heredocs need a writable TMPDIR; on some systems (e.g. Android)
	# the default /tmp is not writable.
	[ -w "${TMPDIR:-/tmp}" ] || export TMPDIR=~

	# Build the color map.  c1..c8 hold the SGR sequences for colors 1-8
	# and are used inside the ASCII art heredocs.
	# shellcheck disable=2034
	for _pf_c in c1 c2 c3 c4 c5 c6 c7 c8; do
		esc SGR "3${_pf_c#?}" 0
		export "$_pf_c=$e"
	done
}

# ============================================================================
#  [DETECT]  System information probes
# ============================================================================
# Each detect_*() function probes one piece of system information and stores
# the result in _pf_val.  If the probe finds nothing worth displaying, it
# leaves _pf_val empty and the renderer will skip the line.
#
# Two functions (detect_title, detect_palette) additionally set:
#   _pf_name   — override the displayed label (used when the "label" itself
#                carries embedded color codes)
#   _pf_nosep  — when non-empty, suppress the name/value separator
#
# detect_platform() and detect_distro() are infrastructure probes called
# once before the main loop; they set persistent _pf_os/_pf_kernel/_pf_arch
# and _pf_distro respectively.

# Cache the output of 'uname' so we never fork for it again.
detect_platform() {
	read -r _pf_os _pf_kernel _pf_arch <<-EOF
		$(uname -srm)
	EOF
}

# Identify the running distribution / operating system.
# This is called *once* before the main loop — both for ASCII art selection
# and for the "os" info module.
detect_distro() {
	case $_pf_os in
		(Linux*)
			# Some Linux distributions (which are based on others)
			# fail to identify as they **do not** change the upstream
			# distribution's identification packages or files.
			#
			# Exceptions are made for distributions which are independent,
			# not based on another distribution or follow different
			# standards.
			if has lsb_release; then
				_pf_distro=$(lsb_release -sd)

			# Android detection: check for characteristic directories.
			elif [ -d /system/app ] && [ -d /system/priv-app ]; then
				_pf_distro="Android $(getprop ro.build.version.release)"

			elif [ -f /etc/os-release ]; then
				# Secure parser: treat os-release as plain key=val text
				# instead of sourcing it directly.
				while IFS='=' read -r key val; do
					case $key in
						(PRETTY_NAME) _pf_distro=$val ;;
					esac
				done < /etc/os-release

			else
				# Special cases for distributions which don't follow
				# any os-release/lsb standards.
				has crux && _pf_distro=$(crux)
				has guix && _pf_distro='Guix System'
			fi

			# Strip quotes that os-release/lsb_release sometimes add.
			_pf_distro=${_pf_distro##[\"\']}
			_pf_distro=${_pf_distro%%[\"\']}

			# Bedrock Linux detection via PATH.
			case $PATH in
				(*/bedrock/cross/*) _pf_distro='Bedrock Linux' ;;
			esac

			# WSL detection.
			if [ "$WSLENV" ]; then
				_pf_distro="${_pf_distro}${WSLENV+ on Windows 10 [WSL2]}"
			elif [ -z "${_pf_kernel%%*-Microsoft}" ]; then
				_pf_distro="$_pf_distro on Windows 10 [WSL1]"
			fi
		;;

		(Darwin*)
			# Parse SystemVersion.plist for macOS version info.
			while IFS='<>' read -r _ _ line _; do
				case $line in
					(ProductVersion)
						IFS='<>' read -r _ _ mac_version _
						continue
					;;
					(ProductName)
						IFS='<>' read -r _ _ mac_product _
						continue
					;;
				esac
			done < /System/Library/CoreServices/SystemVersion.plist

			case $mac_version in
				(10.4*)  _pf_distro='Mac OS X Tiger' ;;
				(10.5*)  _pf_distro='Mac OS X Leopard' ;;
				(10.6*)  _pf_distro='Mac OS X Snow Leopard' ;;
				(10.7*)  _pf_distro='Mac OS X Lion' ;;
				(10.8*)  _pf_distro='OS X Mountain Lion' ;;
				(10.9*)  _pf_distro='OS X Mavericks' ;;
				(10.10*) _pf_distro='OS X Yosemite' ;;
				(10.11*) _pf_distro='OS X El Capitan' ;;
				(10.12*) _pf_distro='macOS Sierra' ;;
				(10.13*) _pf_distro='macOS High Sierra' ;;
				(10.14*) _pf_distro='macOS Mojave' ;;
				(10.15*) _pf_distro='macOS Catalina' ;;
				(11*)    _pf_distro='macOS Big Sur' ;;
				(12*)    _pf_distro='macOS Monterey' ;;
				(*)      _pf_distro='macOS' ;;
			esac

			case $mac_product in
				(iP*) _pf_distro='iOS' ;;
			esac

			_pf_distro="$_pf_distro $mac_version"
		;;

		(Haiku)
			_pf_distro=$(uname -sv)
		;;

		(Minix|DragonFly)
			_pf_distro="$_pf_os $_pf_kernel"
			# Minix and DragonFly don't support the escape
			# sequences used, clear the exit trap.
			trap '' EXIT
		;;

		(SunOS)
			IFS='(' read -r _pf_distro _ < /etc/release
		;;

		(OpenBSD*)
			IFS=' =' read -r _ _pf_distro openbsd_ver _ <<-EOF
				$(sysctl kern.version)
			EOF
			_pf_distro="$_pf_distro $openbsd_ver"
		;;

		(FreeBSD)
			_pf_distro="$_pf_os $(freebsd-version)"
		;;

		(*)
			_pf_distro="$_pf_os $_pf_kernel"
		;;
	esac
}

# ---------------------------------------------------------------------------
#  Info modules
# ---------------------------------------------------------------------------

detect_title() {
	# Username: $USER with fallback to 'id -un'.
	_pf_t_user=${USER:-$(id -un)}

	# Hostname: $HOSTNAME → cached → hostname command → /etc/hostname.
	# shellcheck disable=3028,2039
	_pf_t_host=${HOSTNAME:-${_pf_hostname:-$(hostname)}}
	[ "$_pf_t_host" ] || read -r _pf_t_host < /etc/hostname

	# Build colored user@host string.  Colors are embedded directly
	# because the title line uses a different color scheme than other
	# info lines (PF_COL3 instead of PF_COL1).
	esc SGR 1
	_pf_t_user=$e$_pf_t_user
	esc SGR "3${PF_COL3:-1}"
	_pf_t_user=$e$_pf_t_user
	esc SGR 1
	_pf_t_user=$_pf_t_user$e

	esc SGR 1
	_pf_t_host=$e$_pf_t_host
	esc SGR "3${PF_COL3:-1}"
	_pf_t_host=$e$_pf_t_host

	# Override the display name — the renderer will use this instead of
	# the module label "title".
	_pf_name="${_pf_t_user}@${_pf_t_host}"
	_pf_val=" "
	_pf_nosep=1
}

detect_os() {
	_pf_val="$_pf_distro"
}

detect_kernel() {
	# Don't print kernel on systems where the OS name includes it.
	case $_pf_os in
		(*BSD*|Haiku|Minix) return ;;
	esac
	_pf_val="$_pf_kernel"
}

detect_host() {
	_pf_h_host=
	case $_pf_os in
		(Linux*)
			# product_name, product_version and device-tree model.
			read -r name    < /sys/devices/virtual/dmi/id/product_name
			read -r version < /sys/devices/virtual/dmi/id/product_version
			read -r model   < /sys/firmware/devicetree/base/model
			_pf_h_host="$name $version $model"
		;;

		(Darwin* | FreeBSD* | DragonFly*)
			_pf_h_host=$(sysctl -n hw.model)
		;;

		(NetBSD*)
			_pf_h_host=$(sysctl -n machdep.dmi.system-vendor \
			                 machdep.dmi.system-product)
		;;

		(OpenBSD*)
			_pf_h_host=$(sysctl -n hw.version)
		;;

		(*BSD* | Minix)
			_pf_h_host=$(sysctl -n hw.vendor hw.product)
		;;
	esac

	# Turn the host string into an argument list so we can iterate
	# over it and remove OEM placeholder strings.
	# shellcheck disable=2046,2086
	{
		set -f
		set +f -- $_pf_h_host
		_pf_h_host=
	}

	# Reconstruct the string excluding OEM boilerplate.
	for word do
		case $word in
		   (To      | [Bb]e      | [Ff]illed | [Bb]y  | O.E.M.  | OEM  |\
		    Not     | Applicable | Specified | System | Product | Name |\
		    Version | Undefined  | Default   | string | INVALID | �    | os |\
		    Type1ProductConfigId )
				continue
			;;
		esac
		_pf_h_host="$_pf_h_host$word "
	done

	_pf_val="${_pf_h_host:-$_pf_arch}"
}

detect_uptime() {
	_pf_u_s='' _pf_u_d='' _pf_u_h='' _pf_u_m='' _pf_u_t='' _pf_u_uptime=''

	case $_pf_os in
		(Linux* | Minix* | SerenityOS*)
			IFS=. read -r _pf_u_s _ < /proc/uptime
		;;

		(Darwin* | *BSD* | DragonFly*)
			_pf_u_s=$(sysctl -n kern.boottime)
			_pf_u_s=${_pf_u_s#*=}
			_pf_u_s=${_pf_u_s%,*}
			_pf_u_s=$(($(date +%s) - _pf_u_s))
		;;

		(Haiku)
			_pf_u_s=$(($(system_time) / 1000000))
		;;

		(SunOS)
			IFS='	.' read -r _ _pf_u_s _ <<-EOF
				$(kstat -p unix:0:system_misc:snaptime)
			EOF
		;;

		(IRIX)
			_pf_u_t=$(LC_ALL=POSIX ps -o etime= -p 1)
			case $_pf_u_t in
				(*-*)   _pf_u_d=${_pf_u_t%%-*} _pf_u_t=${_pf_u_t#*-} ;;
				(*:*:*) _pf_u_h=${_pf_u_t%%:*} _pf_u_t=${_pf_u_t#*:} ;;
			esac
			_pf_u_h=${_pf_u_h#0} _pf_u_t=${_pf_u_t#0}
			_pf_u_s=$((${_pf_u_d:-0}*86400 + ${_pf_u_h:-0}*3600 + ${_pf_u_t%%:*}*60 + ${_pf_u_t#*:}))
		;;
	esac

	# Convert seconds → days, hours, minutes.
	_pf_u_d=$((_pf_u_s / 60 / 60 / 24))
	_pf_u_h=$((_pf_u_s / 60 / 60 % 24))
	_pf_u_m=$((_pf_u_s / 60 % 60))

	case "$_pf_u_d" in ([!0]*) _pf_u_uptime="${_pf_u_uptime}${_pf_u_d}d " ;; esac
	case "$_pf_u_h" in ([!0]*) _pf_u_uptime="${_pf_u_uptime}${_pf_u_h}h " ;; esac
	case "$_pf_u_m" in ([!0]*) _pf_u_uptime="${_pf_u_uptime}${_pf_u_m}m " ;; esac

	_pf_val="${_pf_u_uptime:-0m}"
}

detect_pkgs() {
	# Count installed packages across all detected package managers.
	# Each manager prints one package per line; we pipe everything
	# through 'wc -l' for the final count.
	_pf_p_count=$(
		case $_pf_os in
			(Linux*)
				has bonsai     && bonsai list
				has crux       && pkginfo -i
				has pacman-key && pacman -Qq
				has dpkg       && dpkg-query -f '.\n' -W
				has rpm        && rpm -qa
				has xbps-query && xbps-query -l
				has apk        && apk info
				has guix       && guix package --list-installed
				has opkg       && opkg list-installed

				has kiss       && printf '%s\n' /var/db/kiss/installed/*/
				has cpt-list   && printf '%s\n' /var/db/cpt/installed/*/
				has brew       && printf '%s\n' "$(brew --cellar)/"*
				has emerge     && printf '%s\n' /var/db/pkg/*/*/
				has pkgtool    && printf '%s\n' /var/log/packages/*
				has eopkg      && printf '%s\n' /var/lib/eopkg/package/*

				has nix-store  && {
					nix-store -q --requisites /run/current-system/sw
					nix-store -q --requisites ~/.nix-profile
				}
			;;

			(Darwin*)
				has pkgin      && pkgin list
				has dpkg       && dpkg-query -f '.\n' -W
				has brew       && printf '%s\n' /usr/local/Cellar/*
				has port       && {
					pkg_list=$(port installed)
					case "$pkg_list" in
						("No ports are installed.") ;;
						(*) printf '%s\n' "$pkg_list" ;;
					esac
				}
			;;

			(FreeBSD*|DragonFly*) pkg info ;;
			(OpenBSD*)  printf '%s\n' /var/db/pkg/*/ ;;
			(NetBSD*)   pkg_info ;;
			(Haiku)     printf '%s\n' /boot/system/package-links/* ;;
			(Minix)     printf '%s\n' /usr/pkg/var/db/pkg/*/ ;;
			(SunOS)
				has pkginfo && pkginfo -i
				has pkg     && pkg list
			;;
			(IRIX)      versions -b ;;
			(SerenityOS)
				while IFS=" " read -r type _; do
					[ "$type" != dependency ] &&
						printf "\n"
				done < /usr/Ports/packages.db
			;;
		esac | wc -l
	)

	# Strip whitespace from wc output.
	_pf_p_count=${_pf_p_count#"${_pf_p_count%%[![:space:]]*}"}
	_pf_p_count=${_pf_p_count%"${_pf_p_count##*[![:space:]]}"}

	case $_pf_os in
		(IRIX)   _pf_p_count=$((_pf_p_count - 3)) ;;
		(OpenBSD) _pf_p_count=$((_pf_p_count)) ;;
	esac

	# Only display if count >= 2 (the pattern 1?*|[2-9]* matches
	# any number with 2+ digits or a single digit 2-9).
	case $_pf_p_count in
		(1?*|[2-9]*) _pf_val="$_pf_p_count" ;;
	esac
}

detect_memory() {
	_pf_m_used='' _pf_m_full='' _pf_m_free='' _pf_m_avail=''

	case $_pf_os in
		# Used = Total + Shmem - Free - Buffers - Cached - SReclaimable
		(Linux*)
			while IFS=':k ' read -r key val _; do
				case $key in
					(MemTotal)
						_pf_m_used=$((_pf_m_used + val))
						_pf_m_full=$val
					;;
					(Shmem)
						_pf_m_used=$((_pf_m_used + val))
					;;
					(MemFree | Buffers | Cached | SReclaimable)
						_pf_m_used=$((_pf_m_used - val))
					;;
					(MemAvailable) _pf_m_avail=$val ;;
				esac
			done < /proc/meminfo

			case $_pf_m_avail in
				(*[0-9]*) _pf_m_used=$(((_pf_m_full - _pf_m_avail) / 1024)) ;;
				(*)       _pf_m_used=$((_pf_m_used / 1024)) ;;
			esac
			_pf_m_full=$((_pf_m_full / 1024))
		;;

		(Darwin*)
			_pf_m_full=$(($(sysctl -n hw.memsize) / 1024 / 1024))
			while IFS=:. read -r key val; do
				case $key in
					(*' wired'*|*' active'*|*' occupied'*)
						_pf_m_used=$((_pf_m_used + ${val:-0}))
					;;
				esac
			done <<-EOF
				$(vm_stat)
			EOF
			_pf_m_used=$((_pf_m_used * 4 / 1024))
		;;

		(OpenBSD*)
			_pf_m_full=$(($(sysctl -n hw.physmem) / 1024 / 1024))
			while read -r _ _ line _; do
				_pf_m_used=${line%%M}
			done <<-EOF
				$(vmstat)
			EOF
		;;

		(FreeBSD*|DragonFly*)
			_pf_m_full=$(($(sysctl -n hw.physmem) / 1024 / 1024))
			# shellcheck disable=2046
			{
				set -f
				set +f -- $(sysctl -n hw.pagesize \
				              vm.stats.vm.v_inactive_count \
				              vm.stats.vm.v_free_count \
				              vm.stats.vm.v_cache_count)
			}
			_pf_m_used=$((_pf_m_full - (($2 + $3 + $4) * $1 / 1024 / 1024)))
		;;

		(NetBSD*)
			_pf_m_full=$(($(sysctl -n hw.physmem64) / 1024 / 1024))
			while IFS=':k ' read -r key val _; do
				case $key in
					(MemFree)
						_pf_m_free=$((val / 1024))
						break
					;;
				esac
			done < /proc/meminfo
			_pf_m_used=$((_pf_m_full - _pf_m_free))
		;;

		(Haiku)
			IFS='( )' read -r _ _ _ _ _pf_m_used _ _pf_m_full <<-EOF
				$(sysinfo -mem)
			EOF
			_pf_m_used=$((_pf_m_used / 1024 / 1024))
			_pf_m_full=$((_pf_m_full / 1024 / 1024))
		;;

		(Minix)
			read -r _ _pf_m_full _pf_m_free _ < /proc/meminfo
			_pf_m_used=$((_pf_m_full - _pf_m_free))
			_pf_m_used=$((_pf_m_used / 1024))
			_pf_m_full=$((_pf_m_full / 1024))
		;;

		(SunOS)
			_pf_m_hw_ps=$(pagesize)
			while read -r key val; do
				case $key in
					(*total) _pf_m_pages_full=$val ;;
					(*free)  _pf_m_pages_free=$val ;;
				esac
			done <<-EOF
				$(kstat -p unix:0:system_pages:pagestotal \
				       unix:0:system_pages:pagesfree)
			EOF
			_pf_m_full=$((_pf_m_pages_full * _pf_m_hw_ps / 1024 / 1024))
			_pf_m_free=$((_pf_m_pages_free * _pf_m_hw_ps / 1024 / 1024))
			_pf_m_used=$((_pf_m_full - _pf_m_free))
		;;

		(IRIX)
			while IFS=' :' read -r label _pf_m_full _ _pf_m_free _; do
				case $label in
					(Memory)
						_pf_m_full=${_pf_m_full%M}
						_pf_m_free=${_pf_m_free%M}
						break
					;;
				esac
			done <<-EOF
				$(top -n)
			EOF
			_pf_m_used=$((_pf_m_full - _pf_m_free))
		;;

		(SerenityOS)
			IFS='{}' read -r _ memstat _ < /proc/memstat
			set -f -- "$IFS"
			IFS=,
			for pair in $memstat; do
				case $pair in
					(*user_physical_allocated*)  _pf_m_used=${pair##*:} ;;
					(*user_physical_available*)  _pf_m_free=${pair##*:} ;;
				esac
			done
			IFS=$1
			set +f --
			_pf_m_used=$((_pf_m_used * 4096 / 1024 / 1024))
			_pf_m_free=$((_pf_m_free * 4096 / 1024 / 1024))
			_pf_m_full=$((_pf_m_used + _pf_m_free))
		;;
	esac

	_pf_val="${_pf_m_used:-?}M / ${_pf_m_full:-?}M"
}

detect_wm() {
	_pf_w_wm=

	case $_pf_os in
		(Darwin*) ;; # No WM concept on macOS.

		(*)
			# Don't display WM if X isn't running.
			[ "$DISPLAY" ] || return

			# Try xprop first (works for EWMH-compliant WMs).
			has xprop && {
				_pf_w_id=$(xprop -root -notype _NET_SUPPORTING_WM_CHECK)
				_pf_w_id=${_pf_w_id##* }
				_pf_w_wm=$(xprop -id "$_pf_w_id" -notype -len 25 -f _NET_WM_NAME 8t)
			}

			case $_pf_w_wm in
				(*'_NET_WM_NAME = '*)
					_pf_w_wm=${_pf_w_wm##*_NET_WM_NAME = \"}
					_pf_w_wm=${_pf_w_wm%%\"*}
				;;

				(*)
					# Fallback: scan process list for well-known
					# non-EWMH window managers.
					while read -r ps_line; do
						case $ps_line in
							(*catwm*)     _pf_w_wm=catwm ;;
							(*fvwm*)      _pf_w_wm=fvwm ;;
							(*dwm*)       _pf_w_wm=dwm ;;
							(*2bwm*)      _pf_w_wm=2bwm ;;
							(*monsterwm*) _pf_w_wm=monsterwm ;;
							(*wmaker*)    _pf_w_wm='Window Maker' ;;
							(*sowm*)      _pf_w_wm=sowm ;;
							(*penrose*)   _pf_w_wm=penrose ;;
						esac
					done <<-EOF
						$(ps x)
					EOF
				;;
			esac
		;;
	esac

	_pf_val="$_pf_w_wm"
}

