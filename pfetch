			EOF
		;;

		([Vv]oid*)
			_pf_read_ascii 2 <<-EOF
				${c2}    _______
				${c2} _ \\______ -
				${c2}| \\  ___  \\ |
				${c2}| | /   \ | |
				${c2}| | \___/ | |
				${c2}| \\______ \\_|
				${c2} -_______\\
			EOF
		;;

		([Xx]eonix*)
			_pf_read_ascii 2 <<-EOF
				${c2}    ___  ___
				${c2}___ \  \/  / ___
				${c2}\  \ \    / /  /
				${c2} \  \/    \/  /
				${c2}  \    /\    /
				${c2}   \__/  \__/
			EOF
		;;

		(*)
			# If no distribution match, try the OS-level art.
			[ "$1" ] || {
				ascii_init "$_pf_os"
				return
			}
			printf 'error: %s is not currently supported.\n' "$_pf_os" >&6
			printf 'error: Open an issue for support to be added.\n' >&6
			exit 1
		;;
	esac

	# Measure the ASCII art dimensions.
	# Strip SGR escape sequences so they don't inflate the width count.
	_pf_ascii_width=0
	_pf_ascii_height=0
	while read -r line; do
		_pf_ascii_height=$((_pf_ascii_height + 1))
		[ "${#line}" -gt "$_pf_ascii_width" ] &&
			_pf_ascii_width=${#line}
	done <<-EOF
		$(printf %s "$_pf_ascii" | sed "s/${_pf_esc_c}\[[0-9]*m//g")
	EOF

	# Add a gap between ASCII art and info text.
	_pf_ascii_width=$((_pf_ascii_width + 4))

	# Print the art and reposition cursor at the top for info overlay.
	{
		esc_p SGR 1
		printf '%s' "$_pf_ascii"
		esc_p SGR 0
		esc_p CUU "$_pf_ascii_height"
	} >&6
}

# ============================================================================
#  [RENDER]  Info-line rendering and layout engine
# ============================================================================
# All visible info output goes through render_info().  This is the single
# point of layout logic — no detect_*() function should print directly.

# Compute the alignment width from the PF_INFO item list.
# Called once before the main render loop.
render_compute_align() {
	_pf_info_length=0
	for _pf_ca do
		# Count known modules (including "ascii") so that the
		# alignment width is consistent with the original behavior.
		if [ "$_pf_ca" = "ascii" ] || command -v "detect_$_pf_ca" >/dev/null; then
			[ "${#_pf_ca}" -gt "$_pf_info_length" ] &&
				_pf_info_length=${#_pf_ca}
		fi
	done
	_pf_info_length=$((_pf_info_length + 1))
}

# Print a single info line at the correct position.
#
# Usage:  render_info <module_label> <raw_value>
#
# The detect_*() functions may set these one-shot overrides (consumed and
# reset by each call):
#   _pf_name   — use this string as the display name instead of $1
#   _pf_nosep  — when non-empty, suppress the name/value separator
#
# Globals read:  _pf_ascii_width, _pf_info_length, PF_COL1, PF_COL2,
#                PF_SEP, PF_ALIGN
# Globals write: _pf_info_height
render_info() {
	# Skip lines with no data.
	[ "$2" ] || return 0

	_ri_name=${_pf_name:-$1}
	_ri_nosep=$_pf_nosep

	# Reset one-shot overrides immediately so later calls are unaffected.
	_pf_name=
	_pf_nosep=

	# Normalize whitespace in the value string.
	# shellcheck disable=2046,2086
	{
		set -f
		set +f -- $2
		_ri_val=$*
	}

	# Move cursor right past the ASCII art.
	esc_p CUF "$_pf_ascii_width"

	# Print the info name in bold + PF_COL1 color.
	esc_p SGR "3${PF_COL1-4}"
	esc_p SGR 1
	printf '%s' "$_ri_name"
	esc_p SGR 0

	# Print separator (unless suppressed).
	[ "$_ri_nosep" ] || printf '%s' "$PF_SEP"

	# Align the value column: back by name width, forward by alignment.
	esc_p CUB "${#_ri_name}"
	esc_p CUF "${PF_ALIGN:-$_pf_info_length}"

	# Print the info value in PF_COL2 color.
	esc_p SGR "3${PF_COL2-9}"
	printf '%s' "$_ri_val"
	esc_p SGR 0
	printf '\n'

	_pf_info_height=$((${_pf_info_height:-0} + 1))
}

# Position the cursor below both the ASCII art and info lines.
render_finish() {
	# Only move if info is shorter than the ASCII art.
	[ "${_pf_info_height:-0}" -lt "${_pf_ascii_height:-0}" ] &&
		_pf_cursor_pos=$((_pf_ascii_height - _pf_info_height))

	while [ "${_pf_i:=0}" -le "${_pf_cursor_pos:-0}" ]; do
		printf '\n'
		_pf_i=$((_pf_i + 1))
	done >&6
}

# ============================================================================
#  [MAIN]  Entry point and orchestration
# ============================================================================

main() {
	case $* in
		-v)
			printf '%s 0.7.0\n' "${0##*/}"
			return 0
		;;

		-d)
			# Debug mode: stderr is visible.
		;;

		'')
			exec 2>/dev/null
		;;

		*)
			cat <<EOF
${0##*/}     show system information
${0##*/} -d  show stderr (debug mode)
${0##*/} -v  show version information
EOF
			return 0
		;;
	esac

	# Redirect stdout to /dev/null; all visible output goes via fd 6.
	# This gives us full control over what appears on screen.
	exec 6>&1 >/dev/null

	# ── Initialize ─────────────────────────────────────────────
	config_init

	# Disable line wrapping; restore on exit.
	esc_p DECAWM l >&6
	trap 'esc_p DECAWM h >&6' EXIT

	# ── Platform detection (infrastructure) ────────────────────
	detect_platform
	detect_distro

	# ── Info modules ───────────────────────────────────────────
	# Parse PF_INFO into positional parameters.
	# shellcheck disable=2086
	{
		set -f
		set +f -- ${PF_INFO-ascii title os host kernel uptime pkgs memory}

		# First pass: compute alignment width.
		render_compute_align "$@"

		# Second pass: detect and render each module.
		for _pf_item do
			# Reset per-module output variable.
			_pf_val=

			case $_pf_item in
				(ascii)
					ascii_init
				;;

				(palette)
					detect_palette
					printf '\n' >&6
					render_info "$_pf_item" "$_pf_val" >&6
				;;

				(*)
					if command -v "detect_$_pf_item" >/dev/null; then
						"detect_$_pf_item"
						render_info "$_pf_item" "$_pf_val" >&6
					fi
				;;
			esac
		done
	}

	# ── Finish ─────────────────────────────────────────────────
	render_finish
}

main "$@"
